# Снимок базы и загрузок (S6-02); запускается таймером claims-assistant-backup.timer.
[Unit]
Description=Claims assistant backup (database + uploads)
After=claims-assistant.service

[Service]
Type=oneshot
User=claims
Group=claims
WorkingDirectory=/opt/claims-assistant/app
EnvironmentFile=/etc/claims-assistant/env
ExecStart=/opt/claims-assistant/venv/bin/python -m claims_assistant.ops backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/claims-assistant
UMask=0027
