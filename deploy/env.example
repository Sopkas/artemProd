# /etc/claims-assistant/env — настройки службы (владелец root:claims, права 0640).
# Полный список и значения по умолчанию — README.md и .env.example в репозитории.
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=
LOG_LEVEL=INFO

DATA_PROVIDER=demo
CHECKO_API_KEY=

DATABASE_PATH=/var/lib/claims-assistant/claims.sqlite3
STORAGE_PATH=/var/lib/claims-assistant/uploads
BACKUP_PATH=/var/lib/claims-assistant/backups
BACKUP_KEEP=7
RETENTION_DAYS=30

# Владивосток (UTC+10): «в 09:00 по Владивостоку» — ответ заказчика 17.10.2026.
BUSINESS_UTC_OFFSET_HOURS=10
# Мониторинг (S8-09): ежедневно в это время по BUSINESS_UTC_OFFSET_HOURS.
MONITORING_TIME=09:00
# Пока ключ Checko бесплатный (100 запросов в сутки), мониторингу — 60, остальное карточкам
# и проверкам (заметки к выпуску 0.2.0). На платном тарифе — убрать строку (1000).
MONITORING_REQUEST_LIMIT=60

AI_PROVIDER=off
# Для AI_PROVIDER=polza: ключ polza.ai и модель, выбранная 06.10.2026 (docs/ai-provider.md);
# без AI_MODEL берётся openai/gpt-4.1-mini.
AI_API_KEY=
AI_MODEL=google/gemini-3.8-flash
AI_SEND_COMMENTS=false
