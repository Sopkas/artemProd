# /etc/claims-assistant/env — настройки службы (владелец root:claims, права 0640).
# Полный список и значения по умолчанию — README.md и .env.example в репозитории.
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=
LOG_LEVEL=INFO

DATA_PROVIDER=demo
CHECKO_API_KEY=

DATABASE_PATH=/var/lib/claims-assistant/claims.sqlite3
STORAGE_PATH=/var/lib/claims-assistant/uploads
BACKUP_PATH=/var/lib/claims-assistant/backups
BACKUP_KEEP=7
RETENTION_DAYS=30

BUSINESS_UTC_OFFSET_HOURS=3

AI_PROVIDER=off
AI_SEND_COMMENTS=false
