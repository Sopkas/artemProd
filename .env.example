# Obtain a token from @BotFather. Never commit the actual .env file.
TELEGRAM_BOT_TOKEN=
# Positive numeric Telegram user IDs, separated by commas.
ALLOWED_TELEGRAM_IDS=
LOG_LEVEL=INFO
# Demo provider answer for the company card: ordinary, alarm, incomplete or error.
DEMO_SCENARIO=ordinary
# S6-04: true — демонстрационный пакет, сценарий выбирается по ИНН (docs/demo-script.md)
DEMO_PACKAGE=false

# demo (default) or checko (real organization details; other sections unavailable).
DATA_PROVIDER=demo
CHECKO_API_KEY=

# External sources (S3-02): per-request timeout, retries of transient errors,
# cache of successful sections (seconds, 0 disables), and the per-check budget.
EXTERNAL_TIMEOUT_SECONDS=20
EXTERNAL_MAX_RETRIES=2
EXTERNAL_CACHE_TTL_SECONDS=3600
RUN_TIME_LIMIT_SECONDS=900
RUN_REQUEST_LIMIT=1500

# Retention and backups (S6-02): finished checks older than RETENTION_DAYS are deleted
# with their files; `python -m claims_assistant.ops backup` writes snapshots to BACKUP_PATH.
RETENTION_DAYS=30
RETENTION_SWEEP_SECONDS=21600
BACKUP_PATH=data/backups
BACKUP_KEEP=7

# AI explanations (S5): off (default) or stub; a real provider only after the customer
# confirms it. Comments are sent to the model only with AI_SEND_COMMENTS=true.
AI_PROVIDER=off
# polza.ai: the key from the provider's console; never commit it. AI_MODEL takes an id
# from https://polza.ai/models (openai/gpt-4.1-mini by default). Models hosted in Russia
# (sber/gigachat-2, yandex/yandexgpt-5-lite) do not support a strict JSON schema — set
# AI_RESPONSE_FORMAT=none for them; see docs/ai-provider.md.
AI_API_KEY=
AI_MODEL=openai/gpt-4.1-mini
AI_RESPONSE_FORMAT=json_schema
AI_SEND_COMMENTS=false
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_MAX_REQUEST_CHARS=24000
AI_MAX_OUTPUT_TOKENS=1000
AI_RUN_REQUEST_LIMIT=100
AI_RUN_TOKEN_LIMIT=400000
AI_RUN_TIME_LIMIT_SECONDS=600
# Money limits (S5-03): what one check may spend and what the month may spend.
# The month is counted in the service's own database and survives restarts.
AI_RUN_RUB_LIMIT=50
AI_MONTH_RUB_LIMIT=1000

# Calendar date for «Сегодня»: hours from UTC (3 = Moscow, 10 = Vladivostok).
BUSINESS_UTC_OFFSET_HOURS=3
